# ============================================================
# NINHO — variáveis de ambiente (EXEMPLO — sem segredos reais)
# Copie para um arquivo .env ou preencha diretamente em app/config.js
# ============================================================

# URL do seu projeto Supabase (Project Settings > API > Project URL)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública "anon" (Project Settings > API > Project API keys > anon public)
# Pode ficar no frontend. NUNCA use aqui a chave "service_role".
SUPABASE_ANON_KEY=sua_chave_anon_publica_aqui

# Versão do app (usada no cache do service worker)
APP_VERSION=1.0.0
